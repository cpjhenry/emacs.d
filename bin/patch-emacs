#!/usr/bin/env bash
# patch-emacs
#
# Repair Emacs Client.app after an Emacs Plus installation or upgrade.
#
# The stock client may:
#   - use an empty alternate editor, which starts an Emacs daemon
#   - use -c, which creates a new frame
#
# We want `emacsclient -n': use the existing Emacs server and current
# frame, and return immediately.
#
# Emacs must be completely stopped before this script is run.

set -euo pipefail

client_app="/Applications/Emacs Client.app"
script="$client_app/Contents/Resources/Scripts/main.scpt"

lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

die()
{
    printf '%s\n' "$*" >&2
    exit 1
}

sign_and_register()
{
    printf '%s\n' \
        "Removing extended attributes..." \
        "Removing existing signature..."

    xattr -cr "$client_app"
    codesign --remove-signature "$client_app" 2>/dev/null || true

    printf '%s\n' "Applying ad-hoc signature..."
    codesign --force --deep --sign - "$client_app"

    printf '%s\n' "Verifying signature..."
    codesign --verify --deep --strict "$client_app"

    printf '%s\n' "Registering application with Launch Services..."
    touch "$client_app"
    "$lsregister" -f "$client_app"
}

[[ -d "$client_app" ]] ||
    die "Emacs Client.app not found: $client_app"

[[ -f "$script" ]] ||
    die "main.scpt not found: $script"

[[ -x "$lsregister" ]] ||
    die "Launch Services registration tool not found: $lsregister"

command -v osadecompile >/dev/null 2>&1 ||
    die "osadecompile was not found."

command -v osacompile >/dev/null 2>&1 ||
    die "osacompile was not found."

if pgrep -x Emacs >/dev/null 2>&1; then
    die "Emacs is running. Quit it completely before running this script."
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

source="$tmp/main.applescript"
patched="$tmp/main-patched.applescript"
compiled="$tmp/main.scpt"

osadecompile "$script" > "$source"

sed \
    -e "s/ -a ''//g" \
    -e 's/ -c / /g' \
    -e 's/ -c"/"/g' \
    "$source" > "$patched"

# A previously repaired installation requires no further work.
cmp -s "$source" "$patched" && exit 0

printf '%s\n' \
    "Patching Emacs Client.app..." \
    "  removing daemon autostart (-a '')" \
    "  removing new-frame creation (-c)" \
    "  retaining emacsclient -n"

printf '%s\n' "Recompiling AppleScript..."
osacompile -o "$compiled" "$patched"

printf '%s\n' "Installing patched main.scpt..."
cp "$compiled" "$script"

sign_and_register

printf '\nEmacs Client.app repaired.\n'
