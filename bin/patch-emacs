#!/usr/bin/env bash
# patch-emacs
#
# Repair an Emacs Plus installation after installation or upgrade.
#
# Emacs.app:
#   - inject current PATH as EMACS_PLUS_PATH
#   - preserve existing LSEnvironment entries
#   - re-sign and register only when changed
#
# Emacs Client.app:
#   - remove daemon autostart (-a '')
#   - remove new-frame creation (-c)
#   - retain emacsclient -n
#   - re-sign and register only when changed
#
# Emacs Plus manages site-start.el itself.
#
# Emacs must be completely stopped before this script is run.

set -euo pipefail

emacs_app="/Applications/Emacs.app"
client_app="/Applications/Emacs Client.app"

plistbuddy="/usr/libexec/PlistBuddy"
lsregister="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

die()
{
    printf '%s\n' "$*" >&2
    exit 1
}

say()
{
    printf '%s\n' "$*"
}

sign_and_register()
{
    local app="$1"

    say "Removing extended attributes..."
    xattr -cr "$app"

    say "Removing existing signature..."
    codesign --remove-signature "$app" 2>/dev/null || true

    say "Applying ad-hoc signature..."
    codesign --force --deep --sign - "$app"

    say "Verifying signature..."
    codesign --verify --deep --strict "$app"

    say "Registering application with Launch Services..."
    touch "$app"
    "$lsregister" -f "$app"
}

patch_emacs_app()
{
    local plist="$emacs_app/Contents/Info.plist"
    local current

    [[ -d "$emacs_app" ]] ||
        die "Emacs.app not found: $emacs_app"

    [[ -f "$plist" ]] ||
        die "Info.plist not found: $plist"

    say "Checking Emacs.app PATH..."

    current="$(
        "$plistbuddy" \
            -c 'Print :LSEnvironment:EMACS_PLUS_PATH' \
            "$plist" 2>/dev/null || true
    )"

    if [[ "$current" == "$PATH" ]]; then
        say "Emacs.app: PATH already current"
        return
    fi

    # Do not install an incomplete GUI-style PATH.
    [[ ":$PATH:" == *":/opt/homebrew/bin:"* ]] ||
        die "PATH does not contain /opt/homebrew/bin"

    if [[ -n "$current" ]]; then
        "$plistbuddy" \
            -c "Set :LSEnvironment:EMACS_PLUS_PATH $PATH" \
            "$plist"
    else
        "$plistbuddy" \
            -c "Add :LSEnvironment:EMACS_PLUS_PATH string $PATH" \
            "$plist"
    fi

    say "Emacs.app: PATH injected"

    say "Checking Info.plist..."
    plutil -lint "$plist"

    sign_and_register "$emacs_app"

    say "Emacs.app repaired."
}

patch_emacs_client()
{
    local script="$client_app/Contents/Resources/Scripts/main.scpt"
    local tmp source patched compiled

    [[ -d "$client_app" ]] ||
        die "Emacs Client.app not found: $client_app"

    [[ -f "$script" ]] ||
        die "main.scpt not found: $script"

    tmp="$(mktemp -d)"

    source="$tmp/main.applescript"
    patched="$tmp/main-patched.applescript"
    compiled="$tmp/main.scpt"

    say "Checking Emacs Client Finder handler..."

    osadecompile "$script" > "$source"

    # Restrict changes to the Finder 'on open' handler.
    awk '
        /^[[:space:]]*on open([[:space:]]|$)/ &&
        !/^[[:space:]]*on open location([[:space:]]|$)/ {
            in_open = 1
        }

        in_open {
            gsub(/ -a '\'','\''/, "")
            gsub(/ -c /, " ")
            gsub(/ -c"/, "\"")
        }

        {
            print
        }

        in_open && /^[[:space:]]*end open[[:space:]]*$/ {
            in_open = 0
        }
    ' "$source" > "$patched"

    if cmp -s "$source" "$patched"; then
        say "Emacs Client.app: already patched"
        rm -rf "$tmp"
        return
    fi

    say "Patching Emacs Client.app..."
    say "  removing daemon autostart (-a '')"
    say "  removing new-frame creation (-c)"
    say "  retaining emacsclient -n"

    say "Recompiling AppleScript..."
    osacompile -o "$compiled" "$patched"

    say "Installing patched main.scpt..."
    cp "$compiled" "$script"

    rm -rf "$tmp"

    sign_and_register "$client_app"

    say "Emacs Client.app repaired."
}

# Prerequisites.

[[ -x "$plistbuddy" ]] ||
    die "PlistBuddy not found: $plistbuddy"

[[ -x "$lsregister" ]] ||
    die "Launch Services registration tool not found: $lsregister"

command -v osadecompile >/dev/null 2>&1 ||
    die "osadecompile was not found"

command -v osacompile >/dev/null 2>&1 ||
    die "osacompile was not found"

command -v codesign >/dev/null 2>&1 ||
    die "codesign was not found"

# Do not modify an application while Emacs is running.

if pgrep -x Emacs >/dev/null 2>&1; then
    die "Emacs is running. Quit it completely before proceeding."
fi

# Repair both applications independently.

patch_emacs_app

printf '\n'

patch_emacs_client

printf '\nRepair complete.\n'
